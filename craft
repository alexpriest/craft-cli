#!/usr/bin/env python3
"""craft — a thin, token-frugal CLI over the Craft Docs REST API.

The default way any shell session (Claude Code, scripts) reads or mutates Craft.
Self-contained: uses this dir's `craftapi` client (auth, browser-UA, op/.env creds)
so the secret base_url never lands on a command line. Compact output; --json for raw.

    craft ls [--location unsorted|trash|templates|daily_notes] [--folder ID]
    craft get <docId>                      # rendered markdown
    craft search <term>                    # matches: docId | snippet
    craft new "<title>" [--folder ID] [--stdin]   # --stdin = body markdown from stdin
    craft edit <blockId> "<markdown>"      # edit a block in place
    craft append <blockId> [--stdin]       # write markdown INTO a block's page (nested children)

`new --stdin` and `append` take REAL markdown, handed to Craft whole -- blank line
between paragraphs, and GFM tables, headings, lists and quotes all become native
Craft blocks. Craft extensions worth using: `| a | b |` tables, `<callout>...</callout>`,
`<caption>...</caption>`, `==highlight==` or `<highlight color="red">`, `+ toggle` with
2-space-indented children, `[text](date://YYYY-MM-DD)`, `[text](block://blockId)`.
    craft rm <docId> [<docId> ...]         # soft-delete to trash (batches <=40), verifies
    craft tasks <YYYY-MM-DD> "<text>" ...  # append checkbox tasks to a daily note
                          [--divider auto|always|never]   # auto: ONE per note, not one per call
    craft tag <blockId> <name> ...         # append #tags to a block (Craft renders them as live tags)
    craft rm-block <blockId> ...           # delete blocks  [--doc ID | --date D] [--dry-run] [-y]
    craft undo [<stamp>] [--list] [--to ID]   # put the last rm-block back

Block delete is REAL (`DELETE /blocks`) — an earlier note claiming otherwise was wrong.
But unlike `craft rm`, which soft-deletes a document to a 30-day trash, a deleted BLOCK
has no server-side recovery at all. So `rm-block` journals every block to
~/.local/state/craft-cli/undo/ before deleting, and `craft undo` replays it. Pass
--doc/--date so the journal records placement and undo restores the exact position;
without it undo needs `--to <docId>` and lands the block at the top. Indentation is
NOT recoverable — the API doesn't return it on read, so a restored child comes back
at top level. Deleting a parent promotes its children rather than deleting them.

A Craft MCP covers Claude desktop/mobile (same space); this CLI is the Claude Code path.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
import time
import urllib.parse

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import craftapi as api  # noqa: E402


def _table_to_md(rows) -> str:
    """Render a table block's cell grid as a GFM table (first row = header)."""
    grid = [[str(c.get("value", "")).replace("|", "\\|") for c in r] for r in rows if r]
    if not grid:
        return ""
    width = max(len(r) for r in grid)
    grid = [r + [""] * (width - len(r)) for r in grid]
    lines = ["| " + " | ".join(grid[0]) + " |",
             "|" + "---|" * width]
    lines += ["| " + " | ".join(r) + " |" for r in grid[1:]]
    return "\n".join(lines)


def _write_markdown(base, cred, page_id: str, md: str) -> int:
    """Insert markdown under page_id, letting Craft parse it into real blocks.

    Craft's markdown ingest builds native tables, callouts, headings, toggles and
    nesting -- so pass the document through whole. (Splitting it into one text
    block per line, as this used to, flattened everything into plain paragraphs
    and shredded tables into loose rows.) This path also has no 20-block cap.
    """
    r = api.req("POST", f"{base}/blocks", cred,
                json_body={"markdown": md, "position": {"pageId": page_id, "position": "end"}})
    return len(r.get("items", []))


def _blocks_to_md(node, depth: int = 0, out: list[str] | None = None) -> list[str]:
    """Flatten a /blocks content tree to indented markdown lines."""
    if out is None:
        out = []
    if isinstance(node, list):
        for c in node:
            _blocks_to_md(c, depth, out)
        return out
    if isinstance(node, dict):
        # Table blocks carry a `rows` grid and no `markdown` -- render it, or they
        # vanish from every read path (get, mirror, search context).
        if node.get("type") == "table" and node.get("rows"):
            md = _table_to_md(node["rows"])
        else:
            md = node.get("markdown") or ""
        if md and depth > 0:
            indent = "  " * (depth - 1)
            out.append("\n".join(indent + ln for ln in md.split("\n")))
        for key in ("content", "children", "blocks"):
            if node.get(key):
                _blocks_to_md(node[key], depth + 1, out)
    return out


def cmd_ls(args, base, cred):
    q = ["fetchMetadata=true"]
    if args.location:
        q.append(f"location={args.location}")
    if args.folder:
        q.append(f"folderId={args.folder}")
    data = api.req("GET", f"{base}/documents?" + "&".join(q), cred)
    items = data.get("items", [])
    if args.json:
        print(json.dumps(items, indent=2)); return
    for x in items:
        print(f"{x['id']}  {x.get('title','(untitled)')}")
    print(f"\n{len(items)} document(s)", file=sys.stderr)


def cmd_get(args, base, cred):
    data = api.req("GET", f"{base}/blocks?id={args.doc_id}&maxDepth=20", cred)
    if args.json:
        print(json.dumps(data, indent=2)); return
    title = data.get("markdown") or ""
    if title:
        print(f"# {title}\n")
    # content items sit one level below the page root, so render them at depth 1.
    print("\n".join(_blocks_to_md(data.get("content", []), depth=1)))


def cmd_search(args, base, cred):
    data = api.req("GET", f"{base}/documents/search?include=" + urllib.parse.quote(args.term), cred)
    items = data.get("items", [])
    if args.json:
        print(json.dumps(items, indent=2)); return
    for m in items:
        snippet = (m.get("markdown") or "").replace("\n", " ")[:100]
        print(f"{m.get('documentId','?')}  {snippet}")
    print(f"\n{len(items)} match(es)", file=sys.stderr)


def cmd_new(args, base, cred):
    body = {"documents": [{"title": args.title}]}
    if args.folder:
        body["destination"] = {"folderId": args.folder}
    created = api.req("POST", f"{base}/documents", cred, json_body=body)
    doc = created["items"][0]
    doc_id = doc["id"]
    print(doc_id)
    if args.stdin:
        md = sys.stdin.read().rstrip("\n")
        if md.strip():
            _write_markdown(base, cred, doc_id, md)
    print(f"created {doc.get('clickableLink','')}", file=sys.stderr)


def cmd_append(args, base, cred):
    """Insert markdown as children INTO a block's page (block auto-converts to a page)."""
    md = (sys.stdin.read() if args.stdin else args.markdown).rstrip("\n")
    if not md.strip():
        return
    n = _write_markdown(base, cred, args.block_id, md)
    print(f"appended {n} block(s) into {args.block_id}", file=sys.stderr)


def cmd_edit(args, base, cred):
    api.update_block(base, cred, args.block_id, args.markdown)
    print(f"edited {args.block_id}", file=sys.stderr)


def cmd_rm(args, base, cred):
    ids = args.doc_ids
    for i in range(0, len(ids), 40):  # DELETE caps ~40; larger 500s
        api.req("DELETE", f"{base}/documents", cred, json_body={"documentIds": ids[i:i + 40]})
        if i + 40 < len(ids):
            time.sleep(0.75)  # rate limit ~100/min
    # Verify via trash — the main list is cached and lies for a beat.
    trash = {x["id"] for x in api.req("GET", f"{base}/documents?location=trash", cred).get("items", [])}
    ok = [d for d in ids if d in trash]
    print(f"trashed {len(ok)}/{len(ids)} (recoverable 30d)", file=sys.stderr)
    missing = [d for d in ids if d not in trash]
    if missing:
        print("NOT confirmed in trash: " + ", ".join(missing), file=sys.stderr)
        sys.exit(1)


def _preview(md, n=64):
    md = " ".join((md or "").split())
    return md[:n] + ("…" if len(md) > n else "") or "(empty)"


def cmd_rm_block(args, base, cred):
    """Delete blocks. Journals them first — a deleted block has NO server-side trash."""
    entries = api.capture_blocks(base, cred, args.block_ids, doc_id=args.doc, date=args.date)
    for e in entries:
        flags = []
        if e.get("type") == "page":
            flags.append("PAGE — children will be promoted, not deleted")
        if e.get("placement_unknown"):
            flags.append("placement unknown; undo needs --to <docId>")
        suffix = ("  [" + "; ".join(flags) + "]") if flags else ""
        print(f"  {e['id'][:8]}  {_preview(e['markdown'])}{suffix}", file=sys.stderr)

    if args.dry_run:
        print(f"dry run — {len(entries)} block(s) would be deleted", file=sys.stderr)
        return
    if not args.yes:
        if not sys.stdin.isatty():
            print("refusing to delete without -y (block delete is irreversible)", file=sys.stderr)
            sys.exit(1)
        if input(f"delete {len(entries)} block(s)? [y/N] ").strip().lower() not in ("y", "yes"):
            print("aborted", file=sys.stderr)
            return

    stamp = time.strftime("%Y%m%d-%H%M%S")
    journal = api.write_journal(entries, stamp)
    deleted = api.delete_blocks(base, cred, [e["id"] for e in entries])
    print(f"deleted {len(deleted)}/{len(entries)} block(s) — undo: craft undo {stamp}",
          file=sys.stderr)
    if len(deleted) != len(entries):
        print(f"journal kept at {journal}", file=sys.stderr)
        sys.exit(1)


def cmd_undo(args, base, cred):
    """Restore the blocks from a delete journal (default: the most recent)."""
    journals = sorted(api.UNDO_DIR.glob("*.json")) if api.UNDO_DIR.is_dir() else []
    if args.list or (not journals and not args.stamp):
        if not journals:
            print("no delete journals", file=sys.stderr)
            return
        for j in journals[-20:]:
            entries = json.loads(j.read_text())
            print(f"{j.stem}  {len(entries)} block(s)  {_preview(entries[0]['markdown'], 44)}")
        return
    path = (api.UNDO_DIR / f"{args.stamp}.json") if args.stamp else journals[-1]
    if not path.is_file():
        print(f"no such journal: {path.stem}", file=sys.stderr)
        sys.exit(1)
    entries = json.loads(path.read_text())
    new_ids = api.restore_blocks(base, cred, entries, to_doc=args.to)
    print("\n".join(new_ids))
    print(f"restored {len(new_ids)} block(s) from {path.stem}", file=sys.stderr)


def cmd_tasks(args, base, cred):
    sep = {"auto": None, "always": True, "never": False}[args.divider]
    print("\n".join(api.append_tasks(base, cred, args.date, args.text, separator=sep)))


def cmd_tag(args, base, cred):
    """Append #tags to a block's text — Craft renders literal #name as a live tag."""
    node = api.req("GET", f"{base}/blocks?id={args.block_id}&maxDepth=1", cred)
    md = node.get("markdown") or ""
    added = []
    for name in args.tags:
        name = name.lstrip("#")
        if f"#{name}" not in md:
            md = f"{md} #{name}"
            added.append(name)
    if added:
        api.update_block(base, cred, args.block_id, md)
    print(f"tagged {args.block_id} with {', '.join('#' + a for a in added) or '(already tagged)'}",
          file=sys.stderr)


def main(argv):
    p = argparse.ArgumentParser(prog="craft", description="Craft Docs REST API CLI")
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("ls"); s.add_argument("--location",
        choices=["unsorted", "trash", "templates", "daily_notes"])
    s.add_argument("--folder"); s.add_argument("--json", action="store_true"); s.set_defaults(fn=cmd_ls)

    s = sub.add_parser("get"); s.add_argument("doc_id")
    s.add_argument("--json", action="store_true"); s.set_defaults(fn=cmd_get)

    s = sub.add_parser("search"); s.add_argument("term")
    s.add_argument("--json", action="store_true"); s.set_defaults(fn=cmd_search)

    s = sub.add_parser("new"); s.add_argument("title"); s.add_argument("--folder")
    s.add_argument("--stdin", action="store_true"); s.set_defaults(fn=cmd_new)

    s = sub.add_parser("edit"); s.add_argument("block_id"); s.add_argument("markdown")
    s.set_defaults(fn=cmd_edit)

    s = sub.add_parser("append"); s.add_argument("block_id")
    s.add_argument("markdown", nargs="?", default=""); s.add_argument("--stdin", action="store_true")
    s.set_defaults(fn=cmd_append)

    s = sub.add_parser("rm"); s.add_argument("doc_ids", nargs="+"); s.set_defaults(fn=cmd_rm)

    s = sub.add_parser("tasks"); s.add_argument("date"); s.add_argument("text", nargs="+")
    s.add_argument("--divider", choices=("auto", "always", "never"), default="auto",
                   help="auto (default) = one per note, only when there's writing above it")
    s.set_defaults(fn=cmd_tasks)

    s = sub.add_parser("tag"); s.add_argument("block_id"); s.add_argument("tags", nargs="+")
    s.set_defaults(fn=cmd_tag)

    s = sub.add_parser("rm-block"); s.add_argument("block_ids", nargs="+")
    g = s.add_mutually_exclusive_group()
    g.add_argument("--doc", help="containing docId — lets undo restore exact placement")
    g.add_argument("--date", help="containing daily note (YYYY-MM-DD) — same")
    s.add_argument("--dry-run", action="store_true"); s.add_argument("-y", "--yes",
        action="store_true", help="required when not on a TTY")
    s.set_defaults(fn=cmd_rm_block)

    s = sub.add_parser("undo"); s.add_argument("stamp", nargs="?")
    s.add_argument("--list", action="store_true"); s.add_argument("--to",
        help="docId to restore into when placement wasn't captured")
    s.set_defaults(fn=cmd_undo)

    args = p.parse_args(argv[1:])
    try:
        base, cred = api.creds()
        args.fn(args, base, cred)
    except api.CraftError as e:
        print(f"craft: {e}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
